# Format of ADC events:
# id num dwell delay freqPPM phasePPM freq phase phase_id
# ..  ..    ns    us     ppm  rad/MHz   Hz   rad       ..
[ADC]
1 100 4000 0 0 0 0 5.40528 0
2 100 4000 0 0 0 0 0.258309 0
3 100 4000 0 0 0 0 3.40863 0
4 100 4000 0 0 0 0 2.28987 0
5 100 4000 0 0 0 0 3.18523 0
6 100 4000 0 0 0 0 6.09469 0
7 100 4000 0 0 0 0 4.73508 0
8 100 4000 0 0 0 0 5.38958 0
9 100 4000 0 0 0 0 1.775 0

# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
# Extension list is followed by extension specifications
[EXTENSIONS]
1 1 1 0
2 1 2 0

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1
1 1 TRID
2 2 TRID

